# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real Nx Witness credentials or relay system IDs.

# The ONE Nx Witness Server credential this whole platform needs — no other
# module should ever need a per-camera credential. Point this at either the
# cloud relay (https://<system-id>.relay.vmsproxy.com) or a local/LAN Nx
# server (http://<host>:<port>).
NX_SERVER_URL=https://your-system-id.relay.vmsproxy.com
NX_USERNAME=admin
NX_PASSWORD=change-me

# Nx Witness's own RTSP relay — video is proxied through Nx using the Camera
# ID (GUID) as the RTSP path, so raw per-camera RTSP URLs/passwords are never
# needed anywhere downstream of this service.
NX_RTSP_HOST=192.168.1.67
NX_RTSP_PORT=7001

# Port this service listens on.
PORT=5010
